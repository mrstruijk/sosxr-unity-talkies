// SerialPlugin.cpp 
// 
// Rename file to SerialPlugin.cpp (stored without because otherwise Unity cannot build) 
// Compile as shared library: .dll (Windows) / .bundle (macOS) which needs be placed in a /Plugins folder inside Unity Assets folder. 
//
// Example compilation commands: 
//
// Windows (Visual Studio CPP Build Tools), from https://visualstudio.microsoft.com/visual-cpp-build-tools/: 
// cl /EHsc /MD /LD SerialPlugin.cpp /Fe:SerialPlugin.dll
//
// macOS (clang++):
// clang++ -dynamiclib -o SerialPlugin.bundle SerialPlugin.cpp -framework IOKit -framework CoreFoundation
//
// macOS (inc source file handling)
// cp SerialPlugin SerialPlugin.cpp && clang++ -dynamiclib -o SerialPlugin.bundle SerialPlugin.cpp -framework IOKit -framework CoreFoundation && rm SerialPlugin.cpp

#ifdef _WIN32
#include <windows.h>
#else
#include <termios.h>
#include <unistd.h>
#include <fcntl.h>
#include <errno.h>
#include <string.h>
#endif

#include <iostream>

#define EXPORT extern "C"

// --------------------
// State
// --------------------

#ifdef _WIN32
static HANDLE fd = INVALID_HANDLE_VALUE;
#else
static int fd = -1;
#endif

static bool debugSerial = false;

// --------------------
// Helpers
// --------------------

#ifndef _WIN32
static speed_t baudToSpeed(int baudRate) {
    switch (baudRate) {
        case 4800:   return B4800;
        case 9600:   return B9600;
        case 19200:  return B19200;
        case 38400:  return B38400;
        case 57600:  return B57600;
        case 115200: return B115200;
        default:     return B115200;
    }
}
#endif

// --------------------
// SerialOpen
// --------------------

EXPORT int SerialOpen(const char* portName, int baudRate, bool debug) {
    debugSerial = debug;

#ifdef _WIN32
    fd = CreateFileA(portName, GENERIC_READ | GENERIC_WRITE, 0, NULL,
                     OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
    if (fd == INVALID_HANDLE_VALUE) {
        if (debugSerial) std::cerr << "SerialOpen failed" << std::endl;
        return 0;
    }

    DCB dcb = {0};
    dcb.DCBlength = sizeof(dcb);
    if (!GetCommState(fd, &dcb)) return 0;

    dcb.BaudRate = baudRate;
    dcb.ByteSize = 8;
    dcb.StopBits = ONESTOPBIT;
    dcb.Parity   = NOPARITY;
    SetCommState(fd, &dcb);

    COMMTIMEOUTS t = {0};
    t.ReadIntervalTimeout        = 50;
    t.ReadTotalTimeoutConstant   = 50;
    t.ReadTotalTimeoutMultiplier = 10;
    SetCommTimeouts(fd, &t);

#else
    fd = open(portName, O_RDWR | O_NOCTTY | O_NONBLOCK);
    if (fd < 0) {
        if (debugSerial) std::cerr << "Failed to open port" << std::endl;
        return 0;
    }

    fcntl(fd, F_SETFL, 0);

    struct termios options;
    tcgetattr(fd, &options);

    speed_t spd = baudToSpeed(baudRate);

    cfsetispeed(&options, spd);
    cfsetospeed(&options, spd);

    options.c_cflag |= CS8 | CLOCAL | CREAD;
    options.c_iflag = IGNPAR;
    options.c_oflag = 0;
    options.c_lflag = 0;

    tcflush(fd, TCIFLUSH);
    tcsetattr(fd, TCSANOW, &options);

    // Arduino CDC devices reboot on open → wait
    usleep(800000);
#endif

    if (debugSerial) std::cout << "Serial port opened" << std::endl;
    return 1;
}

// --------------------
// SerialClose
// --------------------

EXPORT void SerialClose() {
#ifdef _WIN32
    if (fd != INVALID_HANDLE_VALUE) CloseHandle(fd);
    fd = INVALID_HANDLE_VALUE;
#else
    if (fd >= 0) close(fd);
    fd = -1;
#endif
    if (debugSerial) std::cout << "Serial port closed" << std::endl;
}

// --------------------
// SerialSetBaud
// --------------------

EXPORT int SerialSetBaud(int baudRate) {
#ifdef _WIN32
    if (fd == INVALID_HANDLE_VALUE) return 0;

    DCB dcb = {0};
    dcb.DCBlength = sizeof(dcb);
    if (!GetCommState(fd, &dcb)) return 0;

    dcb.BaudRate = baudRate;
    if (!SetCommState(fd, &dcb)) return 0;

#else
    if (fd < 0) return 0;

    struct termios options;
    if (tcgetattr(fd, &options) == -1) return 0;

    speed_t spd = baudToSpeed(baudRate);

    cfsetispeed(&options, spd);
    cfsetospeed(&options, spd);

    if (tcsetattr(fd, TCSANOW, &options) == -1) return 0;

    tcflush(fd, TCIOFLUSH);
    usleep(20000); // allow device to switch baud
#endif

    if (debugSerial) std::cout << "Baud rate set to " << baudRate << std::endl;
    return 1;
}

// --------------------
// SerialWrite
// --------------------

EXPORT int SerialWrite(const unsigned char* data, int length) {
    if (length <= 0) return 0;

#ifdef _WIN32
    DWORD written;
    if (!WriteFile(fd, data, length, &written, NULL)) return 0;
    return written;
#else
    int n = write(fd, data, length);
    return (n < 0) ? 0 : n;
#endif
}

// --------------------
// SerialWrite2
// --------------------

EXPORT int SerialWrite2(unsigned char position, unsigned char speed) {
    unsigned char buf[2] = { position, speed };
    return SerialWrite(buf, 2);
}

// --------------------
// SerialRead
// --------------------

EXPORT int SerialRead(unsigned char* buffer, int bufferSize) {
    if (bufferSize <= 0) return 0;

#ifdef _WIN32
    DWORD bytesRead;
    if (!ReadFile(fd, buffer, bufferSize, &bytesRead, NULL)) return 0;
    return bytesRead;
#else
    int n = read(fd, buffer, bufferSize);
    return (n < 0) ? 0 : n;
#endif
}

// --------------------
// SerialRead2
// --------------------

EXPORT int SerialRead2(unsigned char* position, unsigned char* speed) {
    unsigned char buf[2];
    int n = SerialRead(buf, 2);

    if (n <= 0) return 0;

    *position = buf[0];
    *speed    = (n > 1) ? buf[1] : 0;

    return n;
}
